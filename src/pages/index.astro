---
import SiteLayout from '../layouts/SiteLayout.astro';
const features=[
  {number:'01',title:'Guilds',description:'Bring people together around a shared name, identity and goals.',href:'/docs/guilds.html',label:'BUILD TOGETHER'},
  {number:'02',title:'Progression',description:'Earn, unlock and improve with a connected personal and guild economy.',href:'/docs/economy.html',label:'KEEP GROWING'},
  {number:'03',title:'Fishing',description:'Discover new catches, chase rarities and fill out your Fishdex.',href:'/docs/fishing.html',label:'FIND SOMETHING RARE'},
  {number:'04',title:'Games & more',description:'Give the chat something to do, from collecting to friendly competition.',href:'/docs/owo.html',label:'PLAY YOUR WAY'}
];
---
<SiteLayout title="NightGuild — Discord, with more to do" description="Guilds, progression, fishing and games for your Discord community.">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span> A COMMUNITY BOT THAT FEELS LIKE MORE</p>
      <h1>Your server.<br /><span>A little more alive.</span></h1>
      <p class="hero-description">NightGuild gives your Discord community its own things to build, discover and enjoy together. No clutter. Just more reasons to hang out.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/docs/getting-started.html">Get started <span>↗</span></a>
        <a class="text-link" href="/docs/index.html">Explore the docs <span>→</span></a>
      </div>
      <div class="hero-note"><span class="note-line"></span> GUILDS · PROGRESSION · FISHING · COMMUNITY</div>
    </div>
    <div class="hero-card-wrap" aria-label="NightGuild guild preview">
      <div class="hero-card">
        <div class="hero-card-top"><span class="tiny-brand"><span>N</span> NIGHTGUILD</span><span class="online"><i></i> COMMUNITY PREVIEW</span></div>
        <div class="guild-symbol">✳</div>
        <p class="card-overline">YOUR GUILD</p>
        <h2>The Night Crew</h2>
        <p class="guild-caption">A place to build something together.</p>
        <div class="guild-divider"></div>
        <div class="guild-metrics">
          <div><strong>08</strong><span>LEVEL</span></div>
          <div><strong>2,450</strong><span>SHARED XP</span></div>
          <div><strong>06</strong><span>MEMBERS</span></div>
        </div>
        <div class="guild-progress-label"><span>NEXT MILESTONE</span><span>72%</span></div>
        <div class="guild-progress"><span></span></div>
      </div>
      <div class="floating-caption"><span>✦</span> MADE TO PLAY TOGETHER</div>
    </div>
  </section>

  <section class="feature-section" id="features">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">A FEW WAYS TO MAKE IT YOURS</p><h2>More than a list<br />of commands.</h2></div>
        <p>Each part of NightGuild adds something to your community. Use what you like, make it your own, and let it grow from there.</p>
      </div>
      <div class="feature-list">
        {features.map((feature)=><a class="feature-row" href={feature.href}>
          <span class="feature-number">{feature.number}</span>
          <div class="feature-main"><span class="feature-label">{feature.label}</span><h3>{feature.title}</h3></div>
          <p>{feature.description}</p>
          <span class="feature-arrow">↗</span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="closing-section">
    <div class="container closing-inner">
      <div><p class="eyebrow">READY WHEN YOU ARE</p><h2>Make room for<br /><span>something new.</span></h2><p>Start with the guide, explore the features and see what fits your community.</p></div>
      <div class="closing-actions"><a class="button button-primary" href="/docs/getting-started.html">Read the getting started guide <span>↗</span></a><a class="text-link" href="/docs/index.html">Browse documentation <span>→</span></a></div>
      <span class="closing-mark" aria-hidden="true">N</span>
    </div>
  </section>
</SiteLayout>