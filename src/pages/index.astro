---
import SiteLayout from '../layouts/SiteLayout.astro';

const features = [
  { title: 'Guilds', description: 'Build a crew, create an identity and work towards shared goals.', href: 'docs/guilds.html', number: '01' },
  { title: 'Progression', description: 'A connected economy, rewards and upgrades that grow with your community.', href: 'docs/economy.html', number: '02' },
  { title: 'Fishing', description: 'Discover catches, collect rare finds and complete your Fishdex.', href: 'docs/fishing.html', number: '03' },
  { title: 'Community games', description: 'Small activities and shared moments that bring people together.', href: 'docs/index.html', number: '04' }
];
---
<SiteLayout title="NightGuild — A little more for your community" description="NightGuild brings guilds, progression, fishing and community games to your Discord server.">
  <section class="simple-hero container">
    <p class="simple-eyebrow"><span></span> MADE FOR YOUR COMMUNITY</p>
    <h1>Make your server<br />a place to <span>belong.</span></h1>
    <p class="simple-intro">NightGuild brings people together with guilds, shared progression, fishing and games. A little more to do, without making things complicated.</p>
    <div class="simple-actions">
      <a class="simple-button simple-button-primary" href="docs/getting-started.html">Get started <span>↗</span></a>
      <a class="simple-button simple-button-secondary" href="docs/index.html">Explore NightGuild</a>
    </div>
    <div class="simple-preview" aria-label="NightGuild feature preview">
      <div class="simple-preview-heading"><span class="simple-preview-mark">N</span><div><strong>NightGuild</strong><small>YOUR COMMUNITY, YOUR ADVENTURE</small></div><span class="simple-preview-status">READY TO EXPLORE</span></div>
      <div class="simple-preview-content">
        <div><small>YOUR GUILD</small><strong>The Night Crew</strong><span>Growing together, one level at a time.</span></div>
        <div class="simple-preview-stat"><strong>08</strong><small>LEVEL</small></div>
        <div class="simple-preview-stat"><strong>2,450</strong><small>SHARED XP</small></div>
        <div class="simple-preview-stat"><strong>06</strong><small>MEMBERS</small></div>
      </div>
    </div>
  </section>

  <section class="simple-features" id="features">
    <div class="container">
      <div class="simple-section-heading">
        <div><p class="simple-eyebrow">WHAT YOU CAN DO</p><h2>Everything in one place.</h2></div>
        <p>Easy to get into, with plenty to discover as your community grows.</p>
      </div>
      <div class="simple-feature-grid">
        {features.map((feature) => <a class="simple-feature" href={feature.href}>
          <span class="simple-feature-number">{feature.number}</span>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
          <span class="simple-feature-arrow">Learn more ↗</span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="simple-bottom">
    <div class="container simple-bottom-inner">
      <div><p class="simple-eyebrow">GETTING STARTED IS EASY</p><h2>Bring your community<br />a little closer.</h2><p>Take a look at the documentation and see what NightGuild can do for your server.</p></div>
      <a class="simple-button simple-button-primary" href="docs/getting-started.html">Read the guide <span>↗</span></a>
    </div>
  </section>
</SiteLayout>
