---
const {title='NightGuildBot',description='A Discord bot built around guilds, progression, fishing and games.',active='home'}=Astro.props;const root=Astro.url.pathname.startsWith('/docs/')?'../':'./';const nav=[['Home',root+'index.html','home'],['Documentation',root+'docs/index.html','docs'],['Commands',root+'docs/commands.html','commands']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#080d16"/><meta name="description" content={description}/><title>{title}</title><link rel="icon" type="image/webp" href={root+'assets/nightguildbot-logo.webp'}/><link rel="stylesheet" href={root+'assets/style.css'}/></head><body><header class="site-header"><div class="header-inner"><a class="brand" href={root+'index.html'}><img src={root+'assets/nightguildbot-logo.webp'} alt=""/><span>NightGuild<span>Bot</span></span></a><button class="menu-toggle" data-menu-toggle aria-label="Toggle navigation" aria-expanded="false">☰</button><nav class="nav" data-site-nav>{nav.map(([label,href,key])=><a class:list={[active===key?'active':'']} href={href}>{label}</a>)}<a class="nav-cta" href="https://discord.com/" target="_blank" rel="noopener noreferrer">Join the Discord ↗</a></nav></div></header><main><slot/></main><footer class="site-footer"><div class="container footer-inner"><a class="brand" href={root+'index.html'}><img src={root+'assets/nightguildbot-logo.webp'} alt=""/><span>NightGuild<span>Bot</span></span></a><span>Built independently, one feature at a time.</span><div class="footer-links"><a href={root+'terms.html'}>Terms</a><a href={root+'privacy.html'}>Privacy</a><a href="https://github.com/NightGuild/nightguild.github.io">GitHub ↗</a></div><span>© <span data-year></span> NightGuildBot</span></div></footer><script src={root+'assets/app.js'} defer></script></body></html>