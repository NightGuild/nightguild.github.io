---
const {title='NightGuildBot',description='A Discord bot built around guilds, progression, fishing and games.',active='home'}=Astro.props;
const root='/';
const nav=[['Home',root+'index.html','home'],['Documentation',root+'docs/index.html','docs'],['Commands',root+'docs/commands.html','commands']];
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
 <meta name="theme-color" content="#080c10"/><meta name="description" content={description}/>
 <meta property="og:type" content="website"/><meta property="og:site_name" content="NightGuildBot"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content="https://nightguild.github.io/assets/nightguildbot-logo.webp"/>
 <meta name="color-scheme" content="dark"/><title>{title}</title>
 <link rel="icon" type="image/webp" href={root+'assets/nightguildbot-logo.webp'}/>
 <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
 <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet"/>
 <link rel="stylesheet" href={root+'assets/style.css'}/>
</head>
<body>
 <a class="skip-link" href="#main-content">Skip to content</a>
 <header class="site-header"><div class="header-inner">
  <a class="brand" href={root+'index.html'}><img src={root+'assets/nightguildbot-logo.webp'} alt=""/><span>nightguild<span class="brand-bot">bot</span></span></a>
  <button class="menu-toggle" data-menu-toggle aria-label="Toggle navigation" aria-expanded="false">☰</button>
  <nav class="nav" data-site-nav>{nav.map(([label,href,key])=><a class:list={[active===key?'active':'']} href={href}>{label}</a>)}<a class="nav-cta" href="https://discord.com/" target="_blank" rel="noopener noreferrer">Find us on Discord ↗</a></nav>
 </div></header>
 <main id="main-content"><slot/></main>
 <footer class="site-footer"><div class="container footer-inner">
  <a class="brand" href={root+'index.html'}><img src={root+'assets/nightguildbot-logo.webp'} alt=""/><span>nightguild<span class="brand-bot">bot</span></span></a>
  <span class="footer-note">A small project for the big group chats.</span>
  <div class="footer-links"><a href={root+'terms.html'}>Terms</a><a href={root+'privacy.html'}>Privacy</a><a href="https://github.com/NightGuild/nightguild.github.io">GitHub ↗</a></div>
  <span class="copyright">© <span data-year></span> NIGHTGUILDBOT</span>
 </div></footer>
 <script src={root+'assets/app.js'} defer></script>
</body></html>